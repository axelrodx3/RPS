# Safe local/preview defaults. Mainnet has no fallback and is intentionally disabled.
NEXT_PUBLIC_RPS_ENVIRONMENT=local
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_ENABLE_REAL_SOL=false
NEXT_PUBLIC_ENABLE_WAGERING=false
NEXT_PUBLIC_ENABLE_DEPOSITS=false
NEXT_PUBLIC_ENABLE_WITHDRAWALS=false
NEXT_PUBLIC_ENABLE_ADMIN=false

# Supply environment-specific values only through local/Vercel secret storage later.
NEXT_PUBLIC_SOLANA_RPC_HTTP=
NEXT_PUBLIC_SOLANA_RPC_WS=
NEXT_PUBLIC_RPS_PROGRAM_ID=
DATABASE_URL=
REDIS_URL=
